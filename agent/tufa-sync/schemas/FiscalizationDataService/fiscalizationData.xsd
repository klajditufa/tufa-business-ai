<?xml version="1.0" encoding="UTF-8"?><schema xmlns="http://www.w3.org/2001/XMLSchema" xmlns:al="https://eFiskalizimi.tatime.gov.al/FiscalizationDataService/schema" xmlns:bt="http://tempuri.org/#" xmlns:ds="http://www.w3.org/2000/09/xmldsig#" xmlns:vc="http://www.w3.org/2007/XMLSchema-versioning" elementFormDefault="qualified" targetNamespace="https://eFiskalizimi.tatime.gov.al/FiscalizationDataService/schema" vc:minVersion="1.1">

    <import namespace="http://www.w3.org/2000/09/xmldsig#" schemaLocation="xmldsig-core-schema.xsd"/>
    <import namespace="http://tempuri.org/#" schemaLocation="base-data-types.xsd"/>
    <element name="GetInvoicesRequest">
        <annotation>
            <documentation>Root XML element representing get sales invoices message.</documentation>
        </annotation>
        <complexType>
            <all>
                <element name="Header" type="al:InvoicesRequestHeaderType">
                    <annotation>
                        <documentation>XML element representing header of the invoice containing data about the message
                            sent.
                        </documentation>
                    </annotation>
                </element>
                <element name="InvoicesRequestBody" type="al:InvoicesRequestBodyType">
                    <annotation>
                        <documentation>XML element representing body of the request data about the message sent
                        </documentation>
                    </annotation>
                </element>
                <element ref="ds:Signature">
                    <annotation>
                        <documentation>XML element representing signature for the request.</documentation>
                    </annotation>
                </element>
            </all>
            <attribute fixed="Request" name="Id" type="string" use="required">
                <annotation>
                    <documentation>Attribute used for signature creation and verification.</documentation>
                </annotation>
            </attribute>
            <attribute fixed="3" name="Version" type="bt:IntSType" use="required">
                <annotation>
                    <documentation>Attribute used to specify compliance with XSD schema.</documentation>
                </annotation>
            </attribute>
        </complexType>
    </element>

    <complexType name="InvoicesRequestHeaderType">
        <attribute name="UUID" type="bt:UUIDSType" use="required">
            <annotation>
                <documentation>UUID generated by a clients for every request data message sent to the CIS.
                </documentation>
            </annotation>
        </attribute>
        <attribute name="SendDateTime" type="bt:UTCSType" use="required">
            <annotation>
                <documentation>Date and time of sending the request data message to the CIS.</documentation>
            </annotation>
        </attribute>
        <attribute name="Source" type="bt:Hex32SType">
            <annotation>
                <documentation>Only for internal use.</documentation>
            </annotation>
        </attribute>
    </complexType>
    <complexType name="InvoicesRequestBodyType">
        <attribute name="FromDate" type="bt:UTCSType">
            <annotation>
                <documentation>Issue date and time of invoices requested</documentation>
            </annotation>
        </attribute>
        <attribute name="ToDate" type="bt:UTCSType">
            <annotation>
                <documentation>Issue date and time of invoices requested</documentation>
            </annotation>
        </attribute>
        <attribute name="InvTransactionType" type="bt:InvTransactionType" use="required">
            <annotation>
                <documentation>Invoice party type (Buyer or Seller)</documentation>
            </annotation>
        </attribute>
        <attribute name="Page" type="al:Page">
            <annotation>
                <documentation>Attribute used to specify page number.</documentation>
            </annotation>
        </attribute>
        <attribute name="FIC" type="bt:UUIDSType">
            <annotation>
                <documentation>CIS generated verification code that can be used to uniquely identify registered
                    invoice.
                </documentation>
            </annotation>
        </attribute>
    </complexType>

    <element name="GetInvoicesResponse">
        <annotation>
            <documentation>Root XML element representing get invoice response message.</documentation>
        </annotation>
        <complexType>
            <all>
                <element name="Header" type="al:InvoicesResponseHeaderType">
                    <annotation>
                        <documentation>Element representing the header of the message.</documentation>
                    </annotation>
                </element>
                <element name="Invoices" type="al:GetInvoicesType">
                    <annotation>
                        <documentation>XML element representing list of Invoices.</documentation>
                    </annotation>
                </element>
                <element ref="ds:Signature">
                    <annotation>
                        <documentation>XML element representing a signature.</documentation>
                    </annotation>
                </element>
            </all>
            <attribute fixed="Response" name="Id" type="string" use="required">
                <annotation>
                    <documentation>Identification of the response, used to reference a signature.</documentation>
                </annotation>
            </attribute>
            <attribute fixed="3" name="Version" type="bt:IntSType" use="required">
                <annotation>
                    <documentation>Identification of the schema version.</documentation>
                </annotation>
            </attribute>
        </complexType>
    </element>

    <complexType name="InvoicesResponseHeaderType">
        <attribute name="UUID" type="bt:UUIDSType" use="required">
            <annotation>
                <documentation>Element generated by the CIS for every message sent to the client. It uniquely identifies
                    the message sent.
                </documentation>
            </annotation>
        </attribute>
        <attribute name="RequestUUID" type="bt:UUIDSType" use="required">
            <annotation>
                <documentation>Element generated by the TCR and referenced by the CIS. It uniquely identifies the
                    request message for which response message was sent to the TCR.
                </documentation>
            </annotation>
        </attribute>
        <attribute name="SendDateTime" type="bt:UTCSType" use="required">
            <annotation>
                <documentation>Element represents date and time of sending the response message to the TCR.
                </documentation>
            </annotation>
        </attribute>
    </complexType>
    <complexType name="GetInvoicesType">
        <sequence>
            <element maxOccurs="1000" name="Inv" type="al:FisInvoiceType">
                <annotation>
                    <documentation>Element representing a single invoice on the response.</documentation>
                </annotation>
            </element>
        </sequence>
        <attribute name="count" type="bt:IntegerSType">
            <annotation>
                <documentation>Total number of counted invoices for a given period</documentation>
            </annotation>
        </attribute>
    </complexType>
    <complexType name="FisInvoiceType">
        <all>
            <element maxOccurs="1" minOccurs="0" name="SupplyDateOrPeriod" type="al:SupplyDateOrPeriodType">
                <annotation>
                    <documentation>XML element representing supply date or period is supply is different from the date
                        when the invoice was issued.
                    </documentation>
                </annotation>
            </element>
            <element maxOccurs="1" minOccurs="0" name="CorrectiveInv" type="al:CorrectiveInvType">
                <annotation>
                    <documentation>XML element groups data for a corrective invoice.</documentation>
                </annotation>
            </element>
            <element maxOccurs="1" minOccurs="1" name="PayMethods" type="al:PayMethodsType">
                <annotation>
                    <documentation>XML element representing list of payment methods.</documentation>
                </annotation>
                <unique name="UniquePayMethodType">
                    <selector xpath=".//al:PayMethod"/>
                    <field xpath="@Type"/>
                </unique>
            </element>
            <element maxOccurs="1" minOccurs="0" name="Currency" type="al:CurrencyType">
                <annotation>
                    <documentation>XML element representing currency in which the amount on the invoice is expressed.
                    </documentation>
                </annotation>
            </element>
            <element maxOccurs="1" minOccurs="1" name="Seller" type="al:SellerType">
                <annotation>
                    <documentation>XML element representing a seller of the goods.</documentation>
                </annotation>
            </element>
            <element maxOccurs="1" minOccurs="0" name="Buyer" type="al:BuyerType">
                <annotation>
                    <documentation>XML element representing a buyer of the goods.</documentation>
                </annotation>
            </element>
            <element maxOccurs="1" minOccurs="1" name="Items" type="al:InvoiceItemsType">
                <annotation>
                    <documentation>XML element representing list of invoice items (goods or services).</documentation>
                </annotation>
            </element>
            <element maxOccurs="1" minOccurs="0" name="Fees" type="al:FeesType">
                <annotation>
                    <documentation>XML element representing list of fees.</documentation>
                </annotation>
                <unique name="UniqueFeesType">
                    <selector xpath=".//al:Fee"/>
                    <field xpath="@Type"/>
                </unique>
            </element>
            <element maxOccurs="1" minOccurs="0" name="SumInvIICRefs" type="al:SumInvIICRefsType">
                <annotation>
                    <documentation>XML element representing list of invoices IIC referenced by a summary invoice.
                    </documentation>
                </annotation>
            </element>
            <element maxOccurs="1" minOccurs="0" name="BadDebtInv" type="al:BadDebtInvType">
                <annotation>
                    <documentation>XML element groups data for an original invoice that will be declared bad debt
                        invoice, as uncollectible.
                    </documentation>
                </annotation>
            </element>
            <element maxOccurs="1" minOccurs="0" name="SameTaxes" type="al:SameTaxesType">
                <annotation>
                    <documentation>XML element representing list of items of the same VAT rate.</documentation>
                </annotation>
            </element>
        </all>
        <attribute name="TypeOfInv" type="al:InvoiceSType" use="required">
            <annotation>
                <documentation>Type of the item represents the type of invoice item, e.g. regular sale or a returned
                    item.
                </documentation>
            </annotation>
        </attribute>
        <attribute name="IsSimplifiedInv" type="boolean" use="required">
            <annotation>
                <documentation>If the invoice is simplified or not.</documentation>
            </annotation>
        </attribute>
        <attribute name="IsBadDeb" type="boolean" use="optional">
            <annotation>
                <documentation>Is the invoice which refers to an unpaid invoice.</documentation>
            </annotation>
        </attribute>
        <attribute name="TypeOfSelfIss" type="al:SelfIssSType" use="optional">
            <annotation>
                <documentation>Type of self-issuing.</documentation>
            </annotation>
        </attribute>
        <attribute name="IssueDateTime" type="bt:UTCSType" use="required">
            <annotation>
                <documentation>Date and time of invoice created and issued at TCR.</documentation>
            </annotation>
        </attribute>
        <attribute name="SendDateTime" type="bt:UTCSType" use="required">
            <annotation>
                <documentation>Element represents date and time of sending the response message to the TCR.
                </documentation>
            </annotation>
        </attribute>
        <attribute name="InvNum" type="bt:InvNumSType" use="required">
            <annotation>
                <documentation>Invoice number composed of invoice ordinal number, year of invoice issuance and code of
                    TCR that issued invoice.
                </documentation>
            </annotation>
        </attribute>
        <attribute name="InvOrdNum" type="bt:IntegerSType" use="required">
            <annotation>
                <documentation>Invoice ordinal number.</documentation>
            </annotation>
        </attribute>
        <attribute name="TCRCode" type="bt:RegistrationCodeSType" use="optional">
            <annotation>
                <documentation>Code of the device that issued the invoice.</documentation>
            </annotation>
        </attribute>
        <attribute name="IsIssuerInVAT" type="boolean" use="required">
            <annotation>
                <documentation>Is the taxpayer in the VAT system.</documentation>
            </annotation>
        </attribute>
        <attribute name="TaxFreeAmt" type="bt:DecimalNegSType" use="optional">
            <annotation>
                <documentation>Amount on items that are tax free.</documentation>
            </annotation>
        </attribute>
        <attribute name="MarkUpAmt" type="bt:DecimalNegSType" use="optional">
            <annotation>
                <documentation>Amount of the mark-up on the invoice.</documentation>
            </annotation>
        </attribute>
        <attribute name="GoodsExAmt" type="bt:DecimalNegSType" use="optional">
            <annotation>
                <documentation>Total price of delivery of exported goods. There is no VAT on the invoice.
                </documentation>
            </annotation>
        </attribute>
        <attribute name="TotPriceWoVAT" type="bt:DecimalNegSType" use="required">
            <annotation>
                <documentation>Total price of the invoice without VAT.</documentation>
            </annotation>
        </attribute>
        <attribute name="TotVATAmt" type="bt:DecimalNegSType" use="optional">
            <annotation>
                <documentation>Total VAT amount.</documentation>
            </annotation>
        </attribute>
        <attribute name="TotPrice" type="bt:DecimalNegSType" use="required">
            <annotation>
                <documentation>Total price of the invoice including VAT.</documentation>
            </annotation>
        </attribute>
        <attribute name="OperatorCode" type="bt:RegistrationCodeSType" use="required">
            <annotation>
                <documentation>Reference to the operator who is operating on TCR. Value represents code of the
                    operator.
                </documentation>
            </annotation>
        </attribute>
        <attribute name="BusinUnitCode" type="bt:RegistrationCodeSType" use="required">
            <annotation>
                <documentation>Code (ID) of the business unit in which the invoice is issued.</documentation>
            </annotation>
        </attribute>
        <attribute name="SoftCode" type="bt:RegistrationCodeSType" use="required">
            <annotation>
                <documentation>Number of the software used for invoice issuing.</documentation>
            </annotation>
        </attribute>
        <attribute name="ImpCustDecNum" type="bt:String50SType">
            <annotation>
                <documentation>Import customs declaration number. Only for internal use. Must not be populated by a
                    TCR.
                </documentation>
            </annotation>
        </attribute>
        <attribute name="IIC" type="bt:Hex32SType" use="required">
            <annotation>
                <documentation>Issuers’s invoice code which is generated by the cash register of the issuer of the
                    invoice. This is a unique code for every invoice.
                </documentation>
            </annotation>
        </attribute>
        <attribute name="FIC" type="bt:UUIDSType" use="required">
            <annotation>
                <documentation>CIS generated verification code that can be used to uniquely identify registered
                    invoice.
                </documentation>
            </annotation>
        </attribute>
        <attribute name="IICSignature" type="bt:Hex512SType" use="required">
            <annotation>
                <documentation>Signed issuer’s invoice code concatenated parameters.</documentation>
            </annotation>
        </attribute>
        <attribute name="IsReverseCharge" type="boolean" use="required">
            <annotation>
                <documentation>Buyer is obliged to pay taxes by himself rather than issuer does it for him.
                </documentation>
            </annotation>
        </attribute>
        <attribute name="PayDeadline" type="bt:DateSType" use="optional">
            <annotation>
                <documentation>Last day for a payment.</documentation>
            </annotation>
        </attribute>
        <attribute name="IsEinvoice" type="boolean" use="optional">
            <annotation>
                <documentation>Is the invoice fiscalized during the einvoice creation process.</documentation>
            </annotation>
        </attribute>
        <attribute name="EIC" type="bt:UUIDSType" use="optional">
            <annotation>
                <documentation>CIS generated verification code that can be used to uniquely identify registered
                    einvoice.
                </documentation>
            </annotation>
        </attribute>
    </complexType>

    <simpleType name="Offset">
        <annotation>
            <documentation>Offset.</documentation>
        </annotation>
        <restriction base="integer">
            <minInclusive value="0"/>
            <maxInclusive value="1000"/>
        </restriction>
    </simpleType>
    <simpleType name="PartyTypeSType">
        <annotation>
            <documentation>Party types.</documentation>
        </annotation>
        <restriction base="string">
            <enumeration value="BUYER">
                <annotation>
                    <documentation>Buyer type.</documentation>
                </annotation>
            </enumeration>
            <enumeration value="SELLER">
                <annotation>
                    <documentation>Seller type.</documentation>
                </annotation>
            </enumeration>
        </restriction>
    </simpleType>
    <simpleType name="Page">
        <annotation>
            <documentation>Page number of invoice list.</documentation>
        </annotation>
        <restriction base="integer">
            <minInclusive value="1"/>
        </restriction>
    </simpleType>
    <complexType name="SupplyDateOrPeriodType">
        <attribute name="Start" type="bt:DateSType" use="required">
            <annotation>
                <documentation>Issuer's NUIS.</documentation>
            </annotation>
        </attribute>
        <attribute name="End" type="bt:DateSType" use="required">
            <annotation>
                <documentation>Issuer's name.</documentation>
            </annotation>
        </attribute>
    </complexType>
    <complexType name="CorrectiveInvType">
        <attribute name="IICRef" type="bt:Hex32SType" use="required">
            <annotation>
                <documentation>IIC reference on the original invoice.</documentation>
            </annotation>
        </attribute>
        <attribute name="IssueDateTime" type="bt:UTCSType" use="required">
            <annotation>
                <documentation>Date and time the original invoice is created and issued at TCR</documentation>
            </annotation>
        </attribute>
        <attribute name="Type" type="al:CorrectiveInvTypeSType" use="required">
            <annotation>
                <documentation>Type of the corrective invoice.</documentation>
            </annotation>
        </attribute>
    </complexType>
    <simpleType name="CorrectiveInvTypeSType">
        <annotation>
            <documentation>Types of the corrective invoice.</documentation>
        </annotation>
        <restriction base="string">
            <enumeration value="CORRECTIVE">
                <annotation>
                    <documentation>Corrective invoice.</documentation>
                </annotation>
            </enumeration>
            <enumeration value="DEBIT">
                <annotation>
                    <documentation>Debit note.</documentation>
                </annotation>
            </enumeration>
            <enumeration value="CREDIT">
                <annotation>
                    <documentation>Credit note.</documentation>
                </annotation>
            </enumeration>
        </restriction>
    </simpleType>
    <complexType name="CurrencyType">
        <attribute name="Code" type="bt:CurrencyCodeSType" use="required">
            <annotation>
                <documentation>Currency code from the ISO 4217 standard.</documentation>
            </annotation>
        </attribute>
        <attribute name="ExRate" type="bt:DoubleSType" use="required">
            <annotation>
                <documentation>Exchange rate applied to calculate the equivalent amount of foreign currency for the
                    total amount expressed in LEK. Exchange rate express equivalent amount of LEK for 1 unit of foreign
                    currency.
                </documentation>
            </annotation>
        </attribute>
        <attribute name="IsBuying" type="boolean">
            <annotation>
                <documentation>True if exchange transaction is buying of the currency. False if exchange transaction is
                    selling of the currency.
                </documentation>
            </annotation>
        </attribute>
    </complexType>
    <complexType name="SellerType">
        <attribute name="IDType" type="bt:IDTypeSType" use="required">
            <annotation>
                <documentation>Seller's identification number type.</documentation>
            </annotation>
        </attribute>
        <attribute name="IDNum" type="bt:String20SType" use="required">
            <annotation>
                <documentation>Seller's identification number.</documentation>
            </annotation>
        </attribute>
        <attribute name="Name" type="bt:String200SType" use="required">
            <annotation>
                <documentation>Seller's name.</documentation>
            </annotation>
        </attribute>
        <attribute name="Address" type="bt:String400SType">
            <annotation>
                <documentation>Seller's address.</documentation>
            </annotation>
        </attribute>
        <attribute name="Town" type="bt:String200SType">
            <annotation>
                <documentation>Seller's town.</documentation>
            </annotation>
        </attribute>
        <attribute name="Country" type="bt:CountryCodeSType">
            <annotation>
                <documentation>Seller's country.</documentation>
            </annotation>
        </attribute>
    </complexType>
    <complexType name="BuyerType">
        <attribute name="IDType" type="bt:IDTypeSType">
            <annotation>
                <documentation>Buyer's identification number type.</documentation>
            </annotation>
        </attribute>
        <attribute name="IDNum" type="bt:String20SType">
            <annotation>
                <documentation>Buyer's identification number.</documentation>
            </annotation>
        </attribute>
        <attribute name="Name" type="bt:String200SType">
            <annotation>
                <documentation>Buyer's name.</documentation>
            </annotation>
        </attribute>
        <attribute name="Address" type="bt:String400SType">
            <annotation>
                <documentation>Buyer's address.</documentation>
            </annotation>
        </attribute>
        <attribute name="Town" type="bt:String200SType">
            <annotation>
                <documentation>Buyer's town.</documentation>
            </annotation>
        </attribute>
        <attribute name="Country" type="bt:CountryCodeSType">
            <annotation>
                <documentation>Buyer's country.</documentation>
            </annotation>
        </attribute>
    </complexType>
    <complexType name="InvoiceItemsType">
        <sequence>
            <element maxOccurs="1000" name="I" type="al:InvoiceItemType">
                <annotation>
                    <documentation>Element representing a single item on the invoice.</documentation>
                </annotation>
            </element>
        </sequence>
    </complexType>
    <complexType name="BadDebtInvType">
        <attribute name="IICRef" type="bt:Hex32SType" use="required">
            <annotation>
                <documentation>IIC reference on the original invoice.</documentation>
            </annotation>
        </attribute>
        <attribute name="IssueDateTime" type="bt:UTCSType" use="required">
            <annotation>
                <documentation>Date and time the original invoice is created and issued at TCR</documentation>
            </annotation>
        </attribute>
    </complexType>
    <complexType name="FeesType">
        <sequence>
            <element maxOccurs="20" minOccurs="1" name="Fee" type="al:FeeType">
                <annotation>
                    <documentation>Element representing an item of list of fee items.</documentation>
                </annotation>
            </element>
        </sequence>
    </complexType>
    <complexType name="FeeType">
        <attribute name="Type" type="al:FeeTypeSType" use="required">
            <annotation>
                <documentation>Type of the fee.</documentation>
            </annotation>
        </attribute>
        <attribute name="Amt" type="bt:DecimalNegSType" use="required">
            <annotation>
                <documentation>The decimal amount of the fee in the country currency.</documentation>
            </annotation>
        </attribute>
    </complexType>
    <complexType name="SumInvIICRefsType">
        <sequence>
            <element maxOccurs="1000" minOccurs="1" name="SumInvIICRef" type="al:SumInvIICRefType">
                <annotation>
                    <documentation>XML element representing a single IIC reference on the list of SumInvIICRefs.
                    </documentation>
                </annotation>
            </element>
        </sequence>
    </complexType>
    <complexType name="SumInvIICRefType">
        <attribute name="IIC" type="bt:Hex32SType" use="required">
            <annotation>
                <documentation>IIC of the invoice that is referenced by the summary invoice.</documentation>
            </annotation>
        </attribute>
        <attribute name="IssueDateTime" type="bt:UTCSType" use="required">
            <annotation>
                <documentation>Date and time the invoice referenced by the summary invoice is created and issued at
                    TCR.
                </documentation>
            </annotation>
        </attribute>
    </complexType>
    <complexType name="PayMethodsType">
        <sequence>
            <element maxOccurs="10" minOccurs="1" name="PayMethod" type="al:PayMethodType">
                <annotation>
                    <documentation>XML element representing one payment method.</documentation>
                </annotation>
            </element>
        </sequence>
    </complexType>
    <complexType name="PayMethodType">
        <sequence>
            <element maxOccurs="1" minOccurs="0" name="Vouchers" type="al:VouchersType">
                <annotation>
                    <documentation>XML element representing list of voucher numbers if the payment method is voucher.
                    </documentation>
                </annotation>
            </element>
        </sequence>
        <attribute name="Type" type="al:PaymentMethodTypeSType" use="required">
            <annotation>
                <documentation>Type of the payment method.</documentation>
            </annotation>
        </attribute>
        <attribute name="Amt" type="bt:DecimalNegSType" use="required">
            <annotation>
                <documentation>Amount payed by payment method in the country currency.</documentation>
            </annotation>
        </attribute>
        <attribute name="CompCard" type="bt:String50SType" use="optional">
            <annotation>
                <documentation>Company card number if the payment method is company cards.</documentation>
            </annotation>
        </attribute>
    </complexType>
    <complexType name="VouchersType">
        <sequence>
            <element maxOccurs="20" minOccurs="1" name="Voucher" type="al:VoucherType">
                <annotation>
                    <documentation>XML element representing a single voucher number.</documentation>
                </annotation>
            </element>
        </sequence>
    </complexType>
    <complexType name="SameTaxesType">
        <sequence>
            <element maxOccurs="20" minOccurs="1" name="SameTax" type="al:SameTaxType">
                <annotation>
                    <documentation>Element representing an item of list of same tax items.</documentation>
                </annotation>
            </element>
        </sequence>
    </complexType>
    <complexType name="SameTaxType">
        <attribute name="NumOfItems" type="bt:IntSType" use="required">
            <annotation>
                <documentation>Number of items.</documentation>
            </annotation>
        </attribute>
        <attribute name="PriceBefVAT" type="bt:DecimalNegSType" use="required">
            <annotation>
                <documentation>Price before VAT.</documentation>
            </annotation>
        </attribute>
        <attribute name="VATRate" type="bt:DecimalNegSType" use="optional">
            <annotation>
                <documentation>VAT rate.</documentation>
            </annotation>
        </attribute>
        <attribute name="ExemptFromVAT" type="al:ExemptFromVATSameTaxItemSType" use="optional">
            <annotation>
                <documentation>Exempt from VAT.</documentation>
            </annotation>
        </attribute>
        <attribute name="VATAmt" type="bt:DecimalNegSType" use="optional">
            <annotation>
                <documentation>VAT amount.</documentation>
            </annotation>
        </attribute>
    </complexType>
    <complexType name="InvoiceItemType">
        <all>
            <element minOccurs="0" name="VS" type="al:VouchersSoldType">
                <annotation>
                    <documentation>Element representing voucher data linked to this item.</documentation>
                </annotation>
            </element>
        </all>
        <attribute name="N" type="bt:String50SType" use="required">
            <annotation>
                <documentation>Name of the item.</documentation>
            </annotation>
        </attribute>
        <attribute name="C" type="bt:String50SType">
            <annotation>
                <documentation>Code of the item.</documentation>
            </annotation>
        </attribute>
        <attribute name="U" type="bt:String50SType" use="required">
            <annotation>
                <documentation>Unit of measure for specific item – piece, weight, length...</documentation>
            </annotation>
        </attribute>
        <attribute name="Q" type="bt:DoubleNegForQuantityTenSType" use="required">
            <annotation>
                <documentation>Amount or number (quantity) of items.</documentation>
            </annotation>
        </attribute>
        <attribute name="UPB" type="bt:DecimalTwoTenSType" use="required">
            <annotation>
                <documentation>Price of one item before VAT is applied (unit price without VAT).</documentation>
            </annotation>
        </attribute>
        <attribute name="UPA" type="bt:DecimalTwoTenSType" use="required">
            <annotation>
                <documentation>Price of one item after VAT is applied (unit price with VAT). It is calculated as PA/Q.
                </documentation>
            </annotation>
        </attribute>
        <attribute name="R" type="bt:DecimalTwoTenSType">
            <annotation>
                <documentation>Rebate percentage.</documentation>
            </annotation>
        </attribute>
        <attribute name="RR" type="boolean">
            <annotation>
