{
  "name": "cis-client-web",
  "version": "2.0.0",
  "private": true,
  "description": "Web interface of CIS Client. Built into ../cis_client/web, which the Python server serves.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "check": "tsc --noEmit && eslint . && prettier --check .",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@mantine/core": "9.7.3",
    "@mantine/dates": "9.7.3",
    "@mantine/dropzone": "9.7.3",
    "@mantine/hooks": "9.7.3",
    "@tabler/icons-react": "3.49.0",
    "dayjs": "1.11.23",
    "fflate": "0.8.3",
    "pdfmake": "0.2.23",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/pdfmake": "0.2.13",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "4.7.0",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "globals": "16.5.0",
    "postcss-preset-mantine": "1.18.0",
    "postcss-simple-vars": "7.0.1",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vite": "6.4.5"
  }
}
